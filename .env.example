# ─── Database ──────────────────────────────────────────────────────────────
# Neon Postgres connection string.
# Apply schema with: npm run db:migrate
DATABASE_URL="postgresql://user:pass@host.neon.tech/db?sslmode=require"

# ─── LLM providers ─────────────────────────────────────────────────────────
# Tried in order (see src/lib/llm/index.ts). Either alone is enough to run;
# providers without a key are skipped rather than attempted.

# Primary: Gemini via its OpenAI-compatible endpoint. Free tier ~250 req/day.
# NOTE: enabling billing on the Google Cloud project REMOVES the free tier
# entirely — every call becomes billable from token one.
GEMINI_API_KEY=""

# Fallback: OpenRouter. Free tier is 50 req/day, or 1,000/day once $10+ of
# credits has ever been purchased (free models stay $0/token either way).
OPENROUTER_API_KEY=""

# ─── Security ──────────────────────────────────────────────────────────────
# Salt for hashing client IPs. We never store a raw IP, but an unsalted hash is
# trivially reversible by enumerating the IPv4 space — set this in production.
# Generate with: openssl rand -hex 32
APP_SALT=""
